# Comma-separated list of browser origins allowed to call the API.
# Wildcards are rejected on purpose.
PIXELPROOF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where uploads and analysis artifacts are stored (git-ignored). Default: apps/api/.pixelproof
# PIXELPROOF_DATA_DIR=
# Per-image upload limit in MB (default 15), pixel cap per image (default 16000000),
# and how many comparisons to keep on disk (default 25; older ones are deleted).
# PIXELPROOF_MAX_UPLOAD_MB=15
# PIXELPROOF_MAX_PIXELS=16000000
# PIXELPROOF_KEEP_COMPARISONS=25
